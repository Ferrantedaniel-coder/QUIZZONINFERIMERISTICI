# Copiare come .env SOLO in locale. Non committare mai una chiave reale.
OPENAI_API_KEY=

# Modelli configurabili.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.6-terra

# Origini browser autorizzate, separate da virgola.
ALLOWED_ORIGINS=https://ferrantedaniel-coder.github.io,http://localhost:5500,http://localhost:8080

# Limite upload audio in megabyte.
MAX_AUDIO_MB=180

# Porta locale. Railway/hosting può sovrascriverla.
PORT=8787
